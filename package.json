{
  "name": "sirahub",
  "version": "1.0.0",
  "private": true,
  "description": "SiraHub — A Modern Ethiopian Job Marketplace (monorepo root)",
  "workspaces": [
    "backend",
    "frontend",
    "telegram-client"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:telegram": "npm run dev --workspace=telegram-client",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
